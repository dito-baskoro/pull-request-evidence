# PR Evidence Pack environment variables.
#
# For local Nuxt development, copy this file to `.env` and fill in real values.
# For `npm run preview:cloudflare`, use an ignored `.dev.vars` file. In production,
# configure plaintext Worker variables in Cloudflare and encrypted values with
# `wrangler secret put`; do not upload this file as a secret bundle.
#
# Nuxt maps environment variables onto runtimeConfig automatically:
#   NUXT_*         -> runtimeConfig (SERVER-ONLY; may contain secrets)
#   NUXT_PUBLIC_*  -> runtimeConfig.public (included in browser-visible config)
#
# NEVER move a server-only secret to a NUXT_PUBLIC_ variable.

# ---------------------------------------------------------------------------
# SERVER-ONLY values (owned by the Cloudflare Worker / backend operator)
# ---------------------------------------------------------------------------

# GitHub App numeric id. Server-only configuration; this may be a plaintext
# Worker variable. Used to mint short-lived installation tokens server-side.
NUXT_GITHUB_APP_ID=

# GitHub App private key (full PEM, including BEGIN/END lines). Encrypted Worker
# Secret in production. Preserve literal newlines; never expose it to the browser.
NUXT_GITHUB_APP_PRIVATE_KEY=

# GitHub webhook signing secret. Encrypted Worker Secret in production.
NUXT_GITHUB_WEBHOOK_SECRET=

# Secret used to sign the per-user GitHub connect state. GitHub echoes this
# state back on the setup redirect and the server verifies it before recording
# an installation, binding the connect to the user who initiated it. Encrypted
# Worker Secret in production. Generate with `openssl rand -hex 32`.
NUXT_GITHUB_CONNECT_STATE_SECRET=

# Supabase service-role key. Encrypted Worker Secret in production. Bypasses RLS;
# used ONLY in server/utils/supabase/admin.ts and must never reach the client.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# AI provider / gateway API key. Encrypted Worker Secret in production.
NUXT_AI_API_KEY=

# Optional OpenAI-compatible provider or gateway base URL. Server-only
# configuration; this may be a plaintext Worker variable.
NUXT_AI_GATEWAY_BASE_URL=

# ---------------------------------------------------------------------------
# PUBLIC (browser-visible) values
# ---------------------------------------------------------------------------

# Configure these as plaintext Worker variables. They are public by design, but
# deployment-specific values should still be managed outside source control.

# Supabase project URL. Public (used by the browser anon client).
NUXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Public by design; RLS enforces per-user access.
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of this app (used for OAuth/magic-link redirects).
NUXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub App slug (used to build the public install URL). Public.
NUXT_PUBLIC_GITHUB_APP_SLUG=
