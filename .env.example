# PR Evidence Pack environment variables.
#
# Copy this file to `.env` and fill in real values. Nuxt maps env vars to
# runtimeConfig automatically:
#   NUXT_*         -> runtimeConfig (SERVER-ONLY secrets, never in the browser)
#   NUXT_PUBLIC_*  -> runtimeConfig.public (safe to ship to the browser)
#
# NEVER move a server-only secret to a NUXT_PUBLIC_ variable.

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets (owned by the deployment / backend operator)
# ---------------------------------------------------------------------------

# GitHub App numeric id. Owner: backend. Used to mint short-lived installation
# tokens server-side. Never exposed to the browser.
NUXT_GITHUB_APP_ID=

# GitHub App private key (full PEM, including BEGIN/END lines). Owner: backend.
# Multi-line values must be quoted or newline-escaped. Server-only.
NUXT_GITHUB_APP_PRIVATE_KEY=

# GitHub webhook signing secret. Owner: backend. Used to verify webhook payloads.
NUXT_GITHUB_WEBHOOK_SECRET=

# Supabase service-role key. Owner: backend. Bypasses RLS; used ONLY in
# server/utils/supabase/admin.ts. Must never reach the client.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# AI provider / gateway API key. Owner: backend. Server-only.
NUXT_AI_API_KEY=

# Optional AI Gateway base URL (e.g. a Vercel AI Gateway endpoint). Owner: backend.
NUXT_AI_GATEWAY_BASE_URL=

# ---------------------------------------------------------------------------
# PUBLIC (browser-safe) values
# ---------------------------------------------------------------------------

# Supabase project URL. Public (used by the browser anon client).
NUXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Public by design; RLS enforces per-user access.
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of this app (used for OAuth/magic-link redirects).
NUXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub App slug (used to build the public install URL). Public.
NUXT_PUBLIC_GITHUB_APP_SLUG=
